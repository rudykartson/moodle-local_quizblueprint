{{!
    @template local_quizblueprint/validation_errors

    A dismissible-style alert box listing blueprint validation errors.

    Context variables required for this template:
    * heading - "The blueprint could not be imported..." string.
    * errors - array of {message} objects, each message already sanitised for output.

    Example context (json):
    {
        "heading": "The blueprint could not be imported. Please fix the following and re-upload:",
        "errors": [
            {"message": "Row 2: Section Name is required."},
            {"message": "Row 3: Category is required."}
        ]
    }
}}
<div class="alert alert-danger" role="alert">
    <strong>{{heading}}</strong>
    <ul class="mb-0">
        {{#errors}}
        <li>{{message}}</li>
        {{/errors}}
    </ul>
</div>

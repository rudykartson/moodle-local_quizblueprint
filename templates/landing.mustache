{{!
    @template local_quizblueprint/landing

    Landing page: download template (step 1) and upload form (step 2).

    Context variables required for this template:
    * templateurl - signed URL to template.php for the template download.
    * downloadtemplatelabel - button label.
    * downloadtemplatehelp - help text under the step 1 heading.
    * stepdownload - step 1 heading text.
    * stepupload - step 2 heading text.
    * uploadformhtml - the rendered upload_form HTML.

    Example context (json):
    {
        "templateurl": "https://example.com/local/quizblueprint/template.php?cmid=2",
        "downloadtemplatelabel": "Download template",
        "downloadtemplatehelp": "Generates an Excel workbook...",
        "stepdownload": "Step 1 — Download template",
        "stepupload": "Step 2 — Upload completed blueprint",
        "uploadformhtml": "<form>...</form>"
    }
}}
<div class="local-quizblueprint-landing">
    <h3>{{stepdownload}}</h3>
    <p>{{downloadtemplatehelp}}</p>
    <a href="{{templateurl}}" class="btn btn-primary mb-4">{{downloadtemplatelabel}}</a>

    <h3 class="mt-4">{{stepupload}}</h3>
    {{{uploadformhtml}}}
</div>

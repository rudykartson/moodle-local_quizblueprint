{{!
    @template local_quizblueprint/result

    Success page shown after the quiz structure has been built.

    Context variables required for this template:
    * successmessage - "Quiz structure created successfully." string.
    * summarytext - "Created N section(s) and N random question slot(s)." string.
    * backurl - URL back to the quiz editing page.
    * backlabel - link label.

    Example context (json):
    {
        "successmessage": "Quiz structure created successfully.",
        "summarytext": "Created 2 section(s) and 12 random question slot(s).",
        "backurl": "https://example.com/mod/quiz/edit.php?cmid=2",
        "backlabel": "Back to quiz editing"
    }
}}
<div class="local-quizblueprint-result">
    <div class="alert alert-success" role="alert">{{successmessage}}</div>
    <p>{{summarytext}}</p>
    <a href="{{backurl}}" class="btn btn-primary">{{backlabel}}</a>
</div>
